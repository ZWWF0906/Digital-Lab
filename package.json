{
  "name": "digital-lab",
  "version": "1.6.0",
  "description": "Personal Digital Laboratory Desktop Application",
  "main": "main.js",
  "author": "ZWWF0906",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "build:electron": "electron-builder --win",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1"
  },
  "build": {
    "appId": "com.digitallab.desktop",
    "productName": "DigitalLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dashboard.html",
      "styles.css",
      "panels/**/*",
      "i18n.js",
      "locales/**/*",
      "build/icons/**/*",
      "build/fonts/**/*",
      "core/test_hook_policy.js",
      "theme-init.js",
      "lang-init.js",
      "boot-text.js",
      "onboarding.js",
      "splash.js",
      "renderer.js",
      "terminal.html",
      "preload-terminal.js",
      "renderer-terminal.js"
    ],
    "extraResources": [
      {
        "from": "dist/backend.exe",
        "to": "backend.exe"
      }
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "allowElevation": true
    },
    "appx": {
      "identityName": "ZWWF0906.DigitalLab",
      "publisher": "CN=3F42B0C4-82C4-4CD0-A52C-0F4D41EEF8B3",
      "publisherDisplayName": "ZWWF0906",
      "applicationId": "DigitalLab",
      "backgroundColor": "#1a1a2e",
      "showNameOnTiles": true,
      "artifactName": "DigitalLab-${version}.${ext}",
      "languages": [
        "en-US",
        "zh-CN",
        "ja-JP"
      ]
    },
    "electronDist": "node_modules/electron/dist"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
