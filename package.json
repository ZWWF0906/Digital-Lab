{
  "name": "digital-lab",
  "version": "1.0.0",
  "description": "DigitalLab — 个人数字实验室",
  "main": "main.js",
  "author": "ZWWF0906",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.digitallab.desktop",
    "productName": "DigitalLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dashboard.html",
      "styles.css",
      "panels/**/*"
    ],
    "extraResources": [
      {
        "from": "core",
        "to": "core"
      },
      {
        "from": "main.py",
        "to": "main.py"
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "win": {
      "target": "dir",
      "icon": null
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
